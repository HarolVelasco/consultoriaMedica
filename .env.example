# Copia este archivo a .env y completa los valores
# (o exporta las variables en PowerShell antes de uvicorn)

# Email (Gmail con contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=tu@gmail.com
EMAIL_MEDICO=medico@gmail.com

# Visión + IA gratuita (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Opcional: OpenAI para el bot de texto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
